% lecture 14, oct12, chapter 6, Fourier Series
clear all; close all;
tend = 1;
N = 10;
t_length = 1000;
t = linspace(-tend, tend, t_length);
a = 1;
T = 0.5;
% g = @(t) a*max(1-abs(t)/T0, 0);
T0 = 2*T;
t_shift = 0.02;
g = @(t) a*max(1-abs(mod(t-t_shift+T/2,T)-T/2)/T0, 0);

% Plot the periodic signal
figure(1)
plot(t,g(t))
title('a*sinc(b*t) vs. t')
ylabel('g')
xlabel('t')

% Find the coefficients of the Fourier Series
delta_t = t(2)-t(1);
N_period = round(T/delta_t);
ts = linspace(-T/2,T/2,1000);
c0 = (1/T)*trapz(ts,g(ts));
% Calculate the Fourier Series to N terms
y = c0*ones(1,t_length);
cn = zeros(1,N);
ii=1;
n_vec = 1:1:length()
for n=-N:N
    if n~=0
        cn = (1/T)*trapz(ts,g(ts).*exp(-1i*2*pi*n*ts/T));
        cn_vec(ii) = cn;
        y = y + cn.*exp(1i*2*pi*n*t/T);
    end
    ii = ii+1;
end

% Plot the periodic signal
figure(1)
subplot(3,1,1)
plot(t,g(t),'k-')
title('a*sinc(b*t) vs. t')
ylabel('g')
xlabel('t')
hold on
plot(t,real(y),'r--')
subplot(3,1,2)
stem(n,real(cn),'k')
% title('a*sinc(b*t) vs. t')
ylabel('n')
xlabel('Re\{c_n\}')
subplot(3,1,3)
stem(n,imag(cn),'k')
title('a*sinc(b*t) vs. t')
ylabel('g')
xlabel('Im\{c_n\}')
